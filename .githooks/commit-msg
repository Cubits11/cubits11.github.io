#!/bin/sh
# Attribution belongs to Cubits11. No agent names its own contribution.
#
# Strips machine-attribution trailers from a commit message before it is
# written: Co-Authored-By lines naming a model or a vendor no-reply address,
# the session backlink, and the "Generated with" footer. The rule is lexical
# and deliberately narrow — a Co-Authored-By naming a human collaborator is
# left alone, because co-authorship by a person is a fact and this hook is
# not in the business of deleting facts.
#
# Installed by: git config core.hooksPath .githooks
set -e
MSG="$1"
TMP="$MSG.attribution"

grep -viE \
  -e '^[[:space:]]*Co-Authored-By:.*(anthropic|openai|noreply@anthropic|claude|gpt-|copilot|codex|gemini|cursor|devin)' \
  -e '^[[:space:]]*Claude-Session:' \
  -e '^[[:space:]]*(🤖 )?(Co-)?Generated (with|by) \[?(Claude|Cursor|Copilot|Codex)' \
  -e '^[[:space:]]*Assisted-By:.*(anthropic|openai|claude)' \
  "$MSG" > "$TMP" || true

# Collapse the blank lines the removal leaves at the end of the message.
awk 'BEGIN{n=0} {lines[NR]=$0} END{last=0; for(i=1;i<=NR;i++) if(lines[i] ~ /[^[:space:]]/) last=i; for(i=1;i<=last;i++) print lines[i]}' \
  "$TMP" > "$MSG"
rm -f "$TMP"
